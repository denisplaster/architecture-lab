{
  "name": "architecture-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive learning program for software architecture by situation: .NET, Azure and React.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5189 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/singlefile.mjs",
    "build:workshops": "node workshops/01-scaffold-clean-structure/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.md\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
